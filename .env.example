# Copie para .env localmente. No DigitalOcean use App-Level Environment Variables.
# NUNCA commitar .env com segredos reais.

APP_ENV=development
LOG_LEVEL=INFO

# Porta local; no App Platform a plataforma injeta $PORT
PORT=8000

# Token que VOCE define e depois cola no Meta App Dashboard
# (WhatsApp > Configuration > Verify Token). Deve ser igual aqui e na Meta.
META_WEBHOOK_VERIFY_TOKEN=troque-por-token-longo-aleatorio

# App Secret do App Meta (App Dashboard > Settings > Basic).
# Obrigatorio para validar X-Hub-Signature-256 nos POSTs.
META_APP_SECRET=

# Opcional na v1 (webhook so registra eventos em log se vazio)
# No DigitalOcean: vincule o Database component e use ${webhook-meta-db.DATABASE_URL}
DATABASE_URL=
