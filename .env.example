# Copie para .env localmente. NUNCA commitar .env com segredos reais.

APP_ROLE=agent
APP_ENV=development
LOG_LEVEL=INFO
PORT=8765
BIND_HOST=127.0.0.1
INSTALLATION_ID=local-dev

# Postgres local — whatsapp_ph
# DATABASE_URL=postgresql://postgres:SENHA@127.0.0.1:12345/whatsapp_ph

TOKEN_ENCRYPTION_KEY=
PH_API_KEY=
PANEL_TICKET_SECRET=
PHSFTW_ROOT=C:\PHSFTW
# Opcional: pastas extras do GEPH (DiretorioPrincipal / Secundario)
# DIRETORIO_PRINCIPAL=
# DIRETORIO_SECUNDARIO=
GRAPH_API_VERSION=v25.0

# Poll do hub (agente)
HUB_BASE_URL=https://whatsapp-meta-ph-wzewk.ondigitalocean.app
HUB_PULL_SECRET=
POLL_INTERVAL_SECONDS=10
BATCH_DELAY_SECONDS=0.05
PAIR_RATE_MIN_SECONDS=6.0

